u32 disk_name;
u32 disk_dot_root_pointer;
u32 disk_size;
u32 disk_first_free_section;

/* Puts a single byte onto the screen in %08x format. */
func putb(u8 byte) {
    puth(byte / 16);
    puth(byte % 16);
}

/* Reads the specified section (256 bytes) into destination_in_ram. */
func read_disk_section(u32 section, u32 destination_in_ram) {
    disk_seek(section * 256);
    disk_read(256, destination_in_ram);

    puts("Read section 0x");
    dumph32(section);
    puts(" from disk.\n");
}

/* Loads the header. */
func analyze_disk() {
    u32 destination = alc(256);
    read_disk_section(0, destination + __get_MS());

    copy_mem(destination, disk_name, 16);
    destination = destination + 16;
    copy_mem(destination, loc(disk_dot_root_pointer), 4);
    destination = destination + 4;
    copy_mem(destination, loc(disk_size), 4);
    destination = destination + 4;
    copy_mem(destination, loc(disk_first_free_section), 4);
}

/* Dumps a 32 unsigned integer in the %08x format. */
func dumph32(u32 v) {
    putb(v / 16777216);
    putb(v / 65536 % 256);
    putb(v / 256 % 256);
    putb(v % 256);
}

/* Displays a hex dump of a section of RAM. */
func dump_mem(u32 pointer, u32 num_bytes) {
    dumph32(pointer);
    puts(": ");
    while (num_bytes > 0) {
        putb(res8(pointer));
        putc(' ');
        num_bytes = num_bytes - 1;
        pointer = pointer + 1;
        if (num_bytes % 16 == 0) {
            putc('\n');
            dumph32(pointer);
            puts(": ");
        }
    }
    putc('\n');
}

/* Entry point */
func main() {
    disk_name = alc(17);

    analyze_disk();

    puts("Disk name: ");
    puts(disk_name);
    putc('\n');

    puts("Disk size: ");
    putu(disk_size);
    puts(" bytes\n");

    puts(".ROOT start section: ");
    putu(disk_dot_root_pointer);
    putc('\n');

    puts("First free section: ");
    putu(disk_first_free_section);
    putc('\n');

    putc('\n');

    dump_mem(disk_name, 16);
}
