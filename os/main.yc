asm "os/corelinks.yr2";

u8 setup_done;

u32 allocator_first_free;

u32 disk_name;
u32 disk_dir_root_pointer;
u32 disk_size;
u32 disk_first_free_section;
u32 disk_section_count;

/* $ROOT, worked out and kept in memory by fs_analyze_disk(...),
    so that the directory never has to be read from the disk again */
u32 disk_root_dir_sections;
u32 disk_root_dir_size;
u32 disk_root_dir_entries;
u32 p_dir_root;

/* ===========================================================================================
                                        MEMORY DISPLAY
=========================================================================================== */

/* Puts a single byte onto the screen in %08x format. */
func putb(u8 byte) {
    puth(byte / 16);
    puth(byte % 16);
}

/* Dumps a 32 unsigned integer in the %08x format. */
func dumph32(u32 v) {
    putb(v / 16777216);
    putb(v / 65536 % 256);
    putb(v / 256 % 256);
    putb(v % 256);
}

/* Displays a hex dump of a section of RAM. */
func dump_mem(u32 pointer, u32 num_bytes) {
    dumph32(pointer + __get_MS());
    puts(": ");
    while (num_bytes > 0) {
        putb(res8(pointer));
        putc(' ');
        num_bytes = --num_bytes;
        pointer = ++pointer;
        if (num_bytes % 16 == 0) {
            putc('\n');
            dumph32(pointer + __get_MS());
            puts(": ");
        }
    }
    putc('\n');
}

/* ===========================================================================================
                                        FILE SYSTEM
=========================================================================================== */

/* Loads the header and pulls $ROOT into memory, so that the directory
    is read from the disk only once during the whole session. */
func fs_analyze_disk() {
    /* 16 bytes of name + 3 uint32 fields, the header is 28 bytes long */
    u32 destination = alc(28);

    disk_name = alc(17);

    disk_seek(0);
    disk_read(28, destination + __get_MS());

    copy_mem(destination, disk_name, 16);
    destination = destination + 16;
    copy_mem(destination, loc(disk_dir_root_pointer), 4);
    destination = destination + 4;
    copy_mem(destination, loc(disk_size), 4);
    destination = destination + 4;
    copy_mem(destination, loc(disk_first_free_section), 4);

    disk_section_count = disk_size / 512;

    disk_root_dir_sections = fs_get_file_occupying(disk_dir_root_pointer);
    disk_root_dir_size = disk_root_dir_sections * 512;
    disk_root_dir_entries = disk_root_dir_size / 32;

    p_dir_root = malloc(disk_root_dir_size);

    if (p_dir_root == 0) {
        puts("Failed to allocate ");
        putu(disk_root_dir_size);
        puts(" bytes for $ROOT\n");

        p_dir_root = 0;
        disk_root_dir_sections = 0;
        disk_root_dir_size = 0;
        disk_root_dir_entries = 0;

        return;
    }

    fs_read_file_pointer(disk_dir_root_pointer, p_dir_root, disk_root_dir_size, 0);
}

/* Gives the $ROOT copy held by fs_analyze_disk(...) back to the heap,
    so that it stops occupying memory once it is not needed anymore. */
func fs_release_dir_root() {
    if (p_dir_root == 0) {
        return;
    }

    mfree(p_dir_root, disk_root_dir_size);

    p_dir_root = 0;
    disk_root_dir_sections = 0;
    disk_root_dir_size = 0;
    disk_root_dir_entries = 0;
}

/* Returns the next section from the file table. */
func fs_get_continuing_section(u32 from_section) {
    if (from_section >= disk_section_count) {
        puts("WARN: Tried to get invalid sector continuation in file table.\nPress any to continue ...\n");
        getc();
        return 0;
    }

    disk_seek(
        512 + // first section (header)
        from_section * 4 // 4 bytes per section
    );

    u32 ret_val;

    disk_read(4, loc(ret_val) + __get_MS());

    return ret_val;
}

/* Returns the total ammount of sections occupied by a file,
    If passed the first free section, works as measuring
    free space. */
func fs_get_file_occupying(u32 start_section) {
    u32 occupying = 0;
    while (start_section != 0) {
        occupying = ++occupying;
        start_section = fs_get_continuing_section(start_section);
    }
    return occupying;
}

/* Reads bytes from a file pointer address */
func fs_read_file_pointer(u32 start_section, u32 destination, u32 bytes, u32 skip_bytes) {
    while ((skip_bytes >= 512) & (start_section != 0)) {
        skip_bytes = skip_bytes - 512;
        start_section = fs_get_continuing_section(start_section);
    }

    if (start_section == 0) {
        return;
    }

    if (skip_bytes > 0) {
        disk_seek(start_section * 512 + skip_bytes);
        
        u32 chunk = 512 - skip_bytes;
        if (bytes < chunk) {
            chunk = bytes;
        }
        
        disk_read(chunk, destination + __get_MS());
        destination = destination + chunk;
        bytes = bytes - chunk;
        
        start_section = fs_get_continuing_section(start_section);
    }

    while ((bytes > 0) & (start_section != 0)) {
        disk_seek(start_section * 512);
        
        u32 chunk = 512;
        if (bytes < 512) {
            chunk = bytes;
        }
        
        disk_read(chunk, destination + __get_MS());
        destination = destination + chunk;
        bytes = bytes - chunk;
        
        start_section = fs_get_continuing_section(start_section);
    }
}

/* Every directory entry of $ROOT is 32 bytes:
        offset  0 - 24 bytes file name
        offset 24 - uint32_t first section of the file
        offset 28 - uint32_t size of the file in bytes

    $ROOT itself was already pulled into memory by fs_analyze_disk(...),
    so this only walks that copy and never touches the disk. */
func fs_list_dir_root_files() {
    puts("=== FILES IN $ROOT ===\n");

    if (disk_root_dir_entries == 0) {
        puts("$ROOT is not available\n");
        return;
    }

    u32 entry = 0;

    while (entry < disk_root_dir_entries) {
        u32 p_entry_data = p_dir_root + entry * 32;
        u32 file_size = res32(p_entry_data + 28);

        if ((res8(p_entry_data) != 0) & (res8(p_entry_data) != '$')) {
            puts(p_entry_data);
            puts(" (");
            putu(file_size);
            puts(" bytes)\n");
        }
        entry = ++entry;
    }
}

/* ===========================================================================================
                                        ALLOCATOR
=========================================================================================== */

/*
    Design:
        The heap is a singly linked list of free sections, the head of that
        list is kept in the 'allocator_first_free' variable.

        Every free section holds the following structure:

            offset  0 - uint32_t size               - total size of this section
            offset 32 - uint32_t next_free_section  - next free section (0 = end of list)

        The 'next_free_section' pointer lives 32 bytes into the section and not
        right behind the 'size' field, this way the header of a section can never
        be clobbered by a split made out of it (64 is the minimum alloc size).

        A free section is therefore always at least 64 bytes big, which is the
        least amount of bytes able to hold an allocation together with the
        header of the leftover section.

    NOTE:
        wrt32(<value>, <address>) stores <value> at <address>,
        this argument order comes from the 'stp32 <reg> <addr_reg>'
        instruction that 'wrt32' itself is made of.

    NOTE:
        The compiler keeps function parameters in the argument registers
        (0x10, 0x11, ...), which get overwritten while the arguments of a
        nested call are being set up. Every parameter is therefore copied
        into a local variable (those live in the data section) right at the
        start of the functions below.
*/

func alloc_get_free_section_size(u32 free_section_start) {
    u32 section = free_section_start;

    return res32(section);
}

func alloc_set_free_section_size(u32 free_section_start, u32 size) {
    u32 section = free_section_start;
    u32 value = size;

    wrt32(value, section);
}

func alloc_get_next_free_section(u32 free_section_start) {
    u32 section = free_section_start + 32;

    return res32(section);
}

func alloc_set_next_free_section(u32 free_section_start, u32 next_free_section) {
    u32 section = free_section_start + 32;
    u32 value = next_free_section;

    wrt32(value, section);
}

/* Turns everything from 'heap_absolute_start' up to the top of the RAM
    into one single free section. */
func alloc_setup(u32 heap_absolute_start) {
    u32 absolute_start = heap_absolute_start;
    u32 section = absolute_start - __get_MS();

    allocator_first_free = section;

    alloc_set_free_section_size(section, 64 * 1024 * 1024 - absolute_start);
    alloc_set_next_free_section(section, 0);
}

/* Allocates 'size' bytes of memory.
    RETURNS: pointer to the allocated memory, 0 when out of memory. */
func malloc(u32 size) {
    u32 alloc_size = size;

    if (alloc_size < 64) {
        puts("Invalid malloc(...) call:\n\tminimum alloc size is 64,\n\tgot ");
        putu(alloc_size);
        puts(" expanding to 64.\nAny to continue ...\n");
        getc();
        alloc_size = 64;
    }

    if (allocator_first_free == 0) {
        puts("Failed to malloc size ");
        putu(alloc_size);
        puts(", the heap has no free section.\nAny to continue ...\n");
        getc();
        return 0;
    }

    u32 pointer_allocated = allocator_first_free;
    u32 prev_free_pointer = 0;
    u32 available_free_size = alloc_get_free_section_size(pointer_allocated);

    while (available_free_size < alloc_size + 64) {
        /* Remember the section we are leaving, it has to point
            to the new one once the found section gets split. */
        prev_free_pointer = pointer_allocated;
        pointer_allocated = alloc_get_next_free_section(pointer_allocated);

        /* Test for the end of the list before dereferencing it */
        if (pointer_allocated == 0) {
            puts("Failed to malloc size ");
            putu(alloc_size);
            puts(", out of memory.\nAny to continue ...\n");
            getc();
            return 0;
        }

        available_free_size = alloc_get_free_section_size(pointer_allocated);
    }

    u32 next_free_pointer = alloc_get_next_free_section(pointer_allocated);
    u32 allocated_pointer = pointer_allocated;

    /* Split the found section, its tail becomes the new free section */

    pointer_allocated = pointer_allocated + alloc_size;

    alloc_set_free_section_size(pointer_allocated, available_free_size - alloc_size);
    alloc_set_next_free_section(pointer_allocated, next_free_pointer);

    /* And link the new free section into the list */

    if (prev_free_pointer != 0)
        alloc_set_next_free_section(prev_free_pointer, pointer_allocated);
    else
        allocator_first_free = pointer_allocated;

    /*puts("allocated ");
    putu(alloc_size);
    puts(" to 0x");
    dumph32(allocated_pointer + __get_MS());
    putc('\n');*/

    return allocated_pointer;
}

/* Returns 'size' bytes of memory located at 'pointer' back into the heap.
    'size' has to be the very same amount of bytes that was
    requested from malloc(...) for that pointer. */
func mfree(u32 pointer, u32 size) {
    u32 freed_pointer = pointer;
    u32 freed_size = size;

    if (freed_pointer == 0) {
        return;
    }

    if (freed_size < 64) {
        puts("Invalid mfree(...) call:\n\tminimum free size is 64,\n\tgot ");
        putu(freed_size);
        puts(" expanding to 64.\nAny to continue ...\n");
        getc();
        freed_size = 64;
    }

    /* Push the freed section to the head of the free list */

    alloc_set_free_section_size(freed_pointer, freed_size);
    alloc_set_next_free_section(freed_pointer, allocator_first_free);

    allocator_first_free = freed_pointer;

    /*puts("freed ");
    putu(freed_size);
    puts(" from 0x");
    dumph32(freed_pointer + __get_MS());
    putc('\n');*/
}

func term_clear(u32 lines) {
    while (lines > 0) {
        putc('\n');
        lines = --lines;
    }
}

func cpu_burn(u32 loops) {
    while (loops > 0) {
        loops = --loops;
    }
}

func streq(u32 s1, u32 s2) {
    while (1) {
        if (
            res8(s1) !=
            res8(s2)
        ) return 0;

        if (res8(s1) == 0) return 1;

        s1 = ++s1;
        s2 = ++s2;
    }
}

func fungsh_run(u32 p_command) {
    if (res8(p_command) == 0) {
        return 0;
    }

    if (streq(p_command, "clear")) {
        term_clear();
        return 0;
    }

    if (streq(p_command, "ls")) {
        fs_list_dir_root_files();
        return 0;
    }

    if (streq(p_command, "exit")) {
        return 2;
    }
    
    puts("Unknown command: ");
    puts(p_command);
    putc('\n');

    return 1;
}

func shell() {
    u32 command = alc(32);
    u16 caret = 0;
    
    while (1) {
        puts("FungSH $ ");
        u8 typing = 1;

        while (typing) {
            u8 c = getc();

            if (c == '\n') {
                putc('\n');
                u8 exit_c = fungsh_run(command);

                if (exit_c == 0) {}
                else if (exit_c == 1)
                    puts("[FAILED 0x01]\n");
                else if (exit_c == 2) {
                    puts("[EXIT 0x02]");
                    return 0;
                }
                else {
                    puts("[FAILED UNKNOWN EXIT CODE]\n");
                }
                typing = 0;
                caret = 0;
                wrt8(0, command);
            }
            else if (c == '\b') {
                if (caret > 0) {
                    caret = --caret;
                    wrt8(0, command + caret);
                    putc('\b');
                    putc(' ');
                    putc('\b');
                }
                else putc('\a');
            }
            else {
                if (caret < 31) {
                    wrt8(c, command + caret);
                    caret = ++caret;
                    wrt8(0, command + caret);
                    putc(c);
                }
                else putc('\a');
            }
        }
    }
}

/* Entry point */
func main() {
    { // Setup allocator
        puts("[SETUP] Setting up allocator\n");

        /* The heap starts right above the ROM and the data section, the stack
            grows down from 0xFFFF so it stays below it. */
        alloc_setup(0x10000);
    }
    
    { // Setup Disk
        puts("[SETUP] Setting up disk\n");

        fs_analyze_disk();
    }
    
    puts("[SETUP] Done\n");

    term_clear(25);

    // Main code
    
    puts("Welcome to FungOS\n(C) Jan Parik (Honz12 on github) 2026\n");

    puts("Disk name: ");
    puts(disk_name);
    putc('\n');

    puts("Disk size: ");
    putu(disk_size);
    puts(" bytes\n");

    puts("$ROOT start section: ");
    putu(disk_dir_root_pointer);
    putc('\n');

    puts("First free section: ");
    putu(disk_first_free_section);
    puts("\n\n");

    puts("$ROOT size (sections): ");
    putu(disk_root_dir_sections);
    puts("\n\n");

/*
    puts("\nYou can now type to test your keyboard, press ENTER to exit.\n");

    u8 keyboard_test_running = 1;
    while (keyboard_test_running) {
        u8 c = getc();
        if (c == '\n') {
            keyboard_test_running = 0;
        }
        putc(c);
    }

    puts("HALTING\n");
*/

    shell();

    fs_release_dir_root();
}
