asm "os/corelinks.yr2";

u8 setup_done;

/* ===========================================================================================
                                        MEMORY DISPLAY
=========================================================================================== */

/* Puts a single byte onto the screen in %08x format. */
func putb(u8 byte) {
    puth(byte / 16);
    puth(byte % 16);
}

/* Dumps a 32 unsigned integer in the %08x format. */
func dumph32(u32 v) {
    putb(v / 16777216);
    putb(v / 65536 % 256);
    putb(v / 256 % 256);
    putb(v % 256);
}

/* Displays a hex dump of a section of RAM. */
func dump_mem(u32 pointer, u32 num_bytes) {
    u32 pos = 0;
    termf((0x0f * 16) | 4);
    puts("00000000 ");
    termf(2);
    while (num_bytes > 0) {
        putb(res8(pointer));
        putc(' ');
        num_bytes = --num_bytes;
        pointer = ++pointer;
        pos = ++pos;
        if (pos % 16 == 0) {
            putc('\n');
            termf((0x0f * 16) | 4);
            dumph32(pos);
            putc(' ');
            termf(2);
        }
    }
    termf(0);
    putc('\n');
}

func print_file(u32 p_name) {
    u32 file_entry_idx = fs_find_file_entry_idx(p_name);
    if (file_entry_idx == 0xFFFFFFFF) {
        return 1;
    }
    u32 file_size = fs_find_file_size(file_entry_idx);

    u32 allocated_file_memory = malloc(++file_size);

    fs_read_file_pointer(
        fs_find_file_pointer(file_entry_idx),
        allocated_file_memory,
        file_size,
        0
    );

    wrt8(0, allocated_file_memory + file_size);

    puts(allocated_file_memory);

    mfree(allocated_file_memory, ++file_size);

    return 0;
}

func dump_raw_file(u32 p_name) {
    u32 file_entry_idx = fs_find_file_entry_idx(p_name);
    if (file_entry_idx == 0xFFFFFFFF) {
        return 1;
    }
    u32 file_size = fs_find_file_size(file_entry_idx);

    u32 allocated_file_memory = malloc(file_size);

    fs_read_file_pointer(
        fs_find_file_pointer(file_entry_idx),
        allocated_file_memory,
        file_size,
        0
    );

    dump_mem(allocated_file_memory, file_size);
    puts("Read ");
    putu(file_size);
    puts(" bytes\n");

    mfree(allocated_file_memory, file_size);

    return 0;
}

func run_file(u32 p_name) {
    set_up_exit_code(0);

    u32 file_entry_idx = fs_find_file_entry_idx(p_name);
    if (file_entry_idx == 0xFFFFFFFF) {
        return 1;
    }
    u32 file_size = fs_find_file_size(file_entry_idx);

    u32 allocated_file_memory = malloc(file_size);

    fs_read_file_pointer(
        fs_find_file_pointer(file_entry_idx),
        allocated_file_memory,
        file_size,
        0
    );

    __jump_to_user_code(allocated_file_memory);

    mfree(allocated_file_memory, file_size);

    return get_up_exit_code();
}


func term_test_format() {
    u8 color = 0;

    puts("         0123456789abcdef\nNormal:  ");
    while (color < 16) {
        termf(color * 16);
        putc('A');
        color = ++color;
    }

    termf(0);
    puts("\nReverse: ");

    color = 0;

    while (color < 16) {
        termf(color * 16 | 1);
        putc('A');
        color = ++color;
    }

    termf(0);
    puts("\nBold:    ");

    color = 0;

    while (color < 16) {
        termf(color * 16 | 2);
        putc('A');
        color = ++color;
    }

    termf(0);
    puts("\nItalic:  ");

    color = 0;

    while (color < 16) {
        termf(color * 16 | 4);
        putc('A');
        color = ++color;
    }

    termf(0);
    putc('\n');
}

func cpu_burn(u32 loops) {
    while (loops > 0) {
        loops = --loops;
    }
}

func streq(u32 s1, u32 s2) {
    while (1) {
        if (
            res8(s1) !=
            res8(s2)
        ) return 0;

        if (res8(s1) == 0) return 1;

        s1 = ++s1;
        s2 = ++s2;
    }
}

func fungsh_run(u32 p_command) {
    if (res8(p_command) == 0) {
        return 0;
    }

    if (streq(p_command, "help")) {
        putc('\n');
        u32 ret_code = print_file(".SH_HELP");
        putc('\n');
        return ret_code;
    }

    if (streq(p_command, "clear")) {
        term_clear();
        return 0;
    }

    if (streq(p_command, "ls")) {
        fs_list_dir_root_files(0);
        return 0;
    }

    if (streq(p_command, "la")) {
        fs_list_dir_root_files(1);
        return 0;
    }

    if (streq(p_command, "exit")) {
        puts("Goodbye!\n");
        return 2;
    }

    if (streq(p_command, "read")) {
        u32 file_name = alc(24);
        puts("File name: \a");
        readln(file_name, 24);

        return print_file(file_name);
    }

    if (streq(p_command, "raw")) {
        u32 file_name = alc(24);
        puts("File name: \a");
        readln(file_name, 24);

        return dump_raw_file(file_name);
    }

    if (streq(p_command, "run")) {
        u32 file_name = alc(24);
        puts("File name: \a");
        readln(file_name, 24);

        return run_file(file_name);
    }

    if (streq(p_command, "testf")) {
        term_test_format();
        return 0;
    }

    puts("Unknown command: ");
    puts(p_command);
    putc('\n');

    return 1;
}

func readln(u32 buffer, u16 size) {
    u16 caret = 0;

    while (1) {
        u8 c = getc();

        if (c == '\n') {
            putc('\n');
            return 0;
        }
        else if (c == '\b') {
            if (caret > 0) {
                caret = --caret;
                wrt8(0, buffer + caret);
                putc('\b');
                putc(' ');
                putc('\b');
            }
            else putc('\a');
        }
        else {
            if (caret < size - 1) {
                wrt8(c, buffer + caret);
                caret = ++caret;
                wrt8(0, buffer + caret);
                putc(c);
            }
            else putc('\a');
        }
    }
    return 0;
}

func shell() {
    u32 command = alc(32);

    while (1) {
        termf(2);
        puts("FungSH");
        termf(0);
        puts(" $ ");

        readln(command, 32);

        u8 exit_c = fungsh_run(command);

        wrt8(0, command);

        if (exit_c == 0) {}
        else if (exit_c == 1)
            puts("[FAILED 0x01]\n");
        else if (exit_c == 2) {
            puts("[EXIT 0x02]\n");
            return 0;
        }
        else {
            puts("[FAILED UNKNOWN EXIT CODE]\n");
        }
    }
}

/* Entry point */
func main() {
    { // Setup allocator
        puts("[SETUP] Setting up allocator\n");

        /* The heap starts right above the ROM and the data section, the stack
            grows down from 0xFFFF so it stays below it. */
        alloc_setup(0x10000);
    }

    { // Setup Disk
        puts("[SETUP] Setting up disk\n");

        fs_analyze_disk();
    }

    puts("[SETUP] Done\n");

    term_clear();

    // Main code

    puts("Welcome to FungOS\n(C) Jan Parik (Honz12 on github) 2026\n");

    /*puts("Disk name: ");
    puts(disk_name);
    putc('\n');

    puts("Disk size: ");
    putu(disk_size);
    puts(" bytes\n");

    puts("$ROOT start section: ");
    putu(disk_dir_root_pointer);
    putc('\n');

    puts("First free section: ");
    putu(disk_first_free_section);
    puts("\n\n");

    puts("$ROOT size (sections): ");
    putu(disk_root_dir_sections);
    puts("\n\n");*/

    shell();

    fs_release_dir_root();

    puts("Press ANY to restart ...");
    getc();
    __ljump(0, 0); // Restart
}
