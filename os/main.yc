u32 disk_size;
u32 free_space_start;

func copy_disk(u32 start_in_disk, u32 num_bytes, u32 destination_in_ram) {
    if ((start_in_disk > disk_size) | (num_bytes > disk_size - start_in_disk)) {
        puts("INVALID READ\n");
        return 1;
    }

    disk_seek(start_in_disk);

    disk_read(num_bytes, destination_in_ram);

    return 0;
}

func main() {
    free_space_start = 0xFFFF;
    disk_size = 64 * 1024;
    
    puts("STARTING READ FROM DISK ...\n");

    breakpoint;

    copy_disk(0, disk_size, free_space_start);
    
   	breakpoint;

    puts("READ FROM DISK COMPLETED\n");
}
