; ========= KERNEL FUNCTIONS =========

halt:
    int 0x10
    ret

putc:
    push32 0x0f
    ldi8 0x0f 0
    int 0x11
    pop32 0x0f
    ret

puts:
    push32 0x0f
    ldi8 0x0f 1
	add 0x10 0x02 0x10
    int 0x11
    pop32 0x0f
    ret

putsr:
    push32 0x0f
    ldi8 0x0f 1
    int 0x11
    pop32 0x0f
    ret

putu:
    push32 0x0f
    ldi8 0x0f 2
    int 0x11
    pop32 0x0f
    ret

getc:
    push32 0x0f
    ldi8 0x0f 3
	push32 0x10
	int 0x11
	mov 0x10 0x1f
	pop32 0x10
    pop32 0x0f
	ret

disk_read:
    push32 0x0f
    ldi8 0x0f 4
    int 0x11
    pop32 0x0f
    ret

disk_write:
    push32 0x0f
    ldi8 0x0f 5
    int 0x11
    pop32 0x0f
    ret

disk_seek:
    push32 0x0f
    ldi8 0x0f 6
    int 0x11
    pop32 0x0f
    ret

; ======= OTHER =======

__get_MS:
    mov 0x02 0x1f
    ret

__ljump:
    ljmp 0x10 0x11

; ----------------------------
; FUNCTION
; res8
;
res8:
    ldp8 0x1f 0x10
    ret

; ----------------------------
; FUNCTION
; res16
;
res16:
    ldp16 0x1f 0x10
    ret

; ----------------------------
; FUNCTION
; res32
;
res32:
    ldp32 0x1f 0x10
    ret

; ----------------------------
; FUNCTION
; wrt8
;
wrt8:
    stp8 0x10 0x11
    ret

; ----------------------------
; FUNCTION
; wrt16
;
wrt16:
    stp16 0x10 0x11
    ret

; ----------------------------
; FUNCTION
; wrt32
;
wrt32:
    stp32 0x10 0x11
    ret

; Custom functions

puth:
    push32 0x10
    push32 0x11

    ldi8 0x11 10
    lt 0x10 0x11 0x11

    jnz .under_10 0x11

    ldi8 0x11 39
    add 0x10 0x11 0x10
.under_10:

    ldi8 0x11 '0'
    add 0x10 0x11 0x10

    call putc

    pop32 0x11
    pop32 0x10
    ret

; ----------------------------
; FUNCTION
; copy_mem
; 0x10 - ARG - address from
; 0x11 - ARG - address to
; 0x12 - ARG - num bytes
;
copy_mem:
    d8 0xff;
    push32 0x10
    push32 0x11
    push32 0x12
    push32 0x13
.loop:
    ldp8 0x13 0x10
    stp8 0x13 0x11
    inc 0x10
    inc 0x11
    dec 0x12
    jnz .loop 0x12      ; if num bytes is not 0 continue
.end:
    pop32 0x13
    pop32 0x12
    pop32 0x11
    pop32 0x10
    ret

