; ----------------------------
; FUNCTION
; copy_mem
; 0x10 - ARG - address from
; 0x11 - ARG - address to
; 0x12 - ARG - num bytes
;
copy_mem:
    push32 0x10
    push32 0x11
    push32 0x12
    push32 0x13
.loop:
    ldp8 0x13 0x10
    stp8 0x13 0x11
    inc 0x10
    inc 0x11
    dec 0x12
    jnz .loop 0x12      ; if num bytes is not 0 continue
.end:
    pop32 0x13
    pop32 0x12
    pop32 0x11
    pop32 0x10
    ret
