ldi32 0x01 0xffff               ; initialize stack pointer
ldi32 0x03 __ivt                ; initialize IVT pointer

ldi16 0x10 __end_of_kernel
ldi8 0x11 0x0

ljmp 0x10 0x11

; DATA

; KERNEL MESSAGES
    KERNEL_PANIC_TEXT: str "\nKernel Panic\n\0"
    KERNEL_ERROR_TEXT: str "\nKernel Error\n\0"
    REBOOT_PROMPT_TEXT: str "To shutdown press 'q' or 'Q'\nTo reboot press ANY OTHER key ...\n\0"
    ANY_TO_CONTINUE_PROMPT_TEXT: str "To continue press ANY key ...\n\0"

; ERROR MESSAGES
    RAM_INV_ADDR_ERR_TEXT: str "RAM R/W address out of bounds error.\n\0"
    GENERIC_ERR_TEXT: str "Generic error.\n\0"

; USER PROCESS RUNNING DATA
    USER_PROCESS_RUNNING: d8 0
    USER_PROCESS_RETURN_PC: d32 0
    USER_PROCESS_RETURN_MS: d32 0
    USER_PROCESS_EXIT_CODE: d32 0

; CODE

halt:
    ld8 0x10 USER_PROCESS_RUNNING
    jnz .return_from_process 0x10
.loop:
    jmp .loop
.return_from_process:
    ldi8 0x10 0                         ; set running to 0
    st8 0x10 USER_PROCESS_RUNNING

    pop32 0x10
    pop32 0x10

    ld32 0x10 USER_PROCESS_RETURN_PC    ; load return point
    ld32 0x11 USER_PROCESS_RETURN_MS

    ljmp 0x11 0x10

; INTERRUPT HANDLERS

; ----------------------------------------------------------------------------------------
generic_error_interrupt_handler:
    ldi32 0x10 GENERIC_ERR_TEXT
    jmp kernel_panic_handler

; ----------------------------------------------------------------------------------------
ram_inv_addr_error_handler:
    ldi32 0x10 RAM_INV_ADDR_ERR_TEXT
    jmp kernel_panic_handler

; ----------------------------------------------------------------------------------------
syscall_int:
    push32 0x0e

    ldi8 0x0e 0                             ; PUTC
    eq 0x0e 0x0f 0x0e
    jnz .putc 0x0e

    ldi8 0x0e 1                             ; PUTS
    eq 0x0e 0x0f 0x0e
    jnz .puts 0x0e

    ldi8 0x0e 2                             ; PUTU
    eq 0x0e 0x0f 0x0e
    jnz .putu 0x0e

    ldi8 0x0e 3                             ; GETC
    eq 0x0e 0x0f 0x0e
    jnz .getc 0x0e

    ldi8 0x0e 4                             ; DISK_READ
    eq 0x0e 0x0f 0x0e
    jnz .disk_read 0x0e

    ldi8 0x0e 5                             ; DISK_WRITE
    eq 0x0e 0x0f 0x0e
    jnz .disk_write 0x0e

    ldi8 0x0e 6                             ; DISK_SEEK
    eq 0x0e 0x0f 0x0e
    jnz .disk_seek 0x0e

    ldi8 0x0e 7                             ; SET_PROCESS_RET
    eq 0x0e 0x0f 0x0e
    jnz .set_process_ret 0x0e

    ldi8 0x0e 8                             ; SET_UP_EXIT_CODE
    eq 0x0e 0x0f 0x0e
    jnz .set_up_exit_code 0x0e

    ldi8 0x0e 9                             ; GET_UP_EXIT_CODE
    eq 0x0e 0x0f 0x0e
    jnz .get_up_exit_code 0x0e

    ldi8 0x0e 10                            ; ALLOC_MALLOC
    eq 0x0e 0x0f 0x0e
    jnz .malloc 0x0e

    ldi8 0x0e 11                            ; ALLOC_MFREE
    eq 0x0e 0x0f 0x0e
    jnz .mfree 0x0e

    ldi8 0x0e 12                            ; FS_ANALYZE_DISK
    eq 0x0e 0x0f 0x0e
    jnz .fs_analyze_disk 0x0e

    ldi8 0x0e 13                            ; FS_RESEASE_DIR_ROOT
    eq 0x0e 0x0f 0x0e
    jnz .fs_release_dir_root 0x0e

    ldi8 0x0e 14                            ; FS_GET_CONTINUING_SECTION
    eq 0x0e 0x0f 0x0e
    jnz .fs_get_continuing_section 0x0e

    ldi8 0x0e 15                            ; FS_GET_FILE_OCCUPYING
    eq 0x0e 0x0f 0x0e
    jnz .fs_get_file_occupying 0x0e

    ldi8 0x0e 16                            ; FS_READ_FILE_POINTER
    eq 0x0e 0x0f 0x0e
    jnz .fs_read_file_pointer 0x0e

    ldi8 0x0e 17                            ; FS_LIST_DIR_ROOT_FILES
    eq 0x0e 0x0f 0x0e
    jnz .fs_list_dir_root_files 0x0e

    ldi8 0x0e 18                            ; fs_find_file_entry_idx
    eq 0x0e 0x0f 0x0e
    jnz .fs_find_file_entry_idx 0x0e

    ldi8 0x0e 19                            ; fs_find_file_pointer
    eq 0x0e 0x0f 0x0e
    jnz .fs_find_file_pointer 0x0e

    ldi8 0x0e 20                            ; fs_find_file_size
    eq 0x0e 0x0f 0x0e
    jnz .fs_find_file_size 0x0e

    ldi8 0x0e 21                            ; alloc_setup
    eq 0x0e 0x0f 0x0e
    jnz .alloc_setup 0x0e
.end:
    pop32 0x0e
    iret
.putc:
    call putc
    jmp .end
.puts:
    call puts
    jmp .end
.putu:
    call putu
    jmp .end
.getc:
	call getc
    jmp .end
.disk_read:
    call disk_read
    jmp .end
.disk_write:
    call disk_write
    jmp .end
.disk_seek:
    call disk_seek
    jmp .end
.set_process_ret:
    call set_process_ret
    jmp .end
.set_up_exit_code:
    call set_up_exit_code
    jmp .end
.get_up_exit_code:
    call get_up_exit_code
    jmp .end
.malloc:
    call malloc
    jmp .end
.mfree:
    call mfree
    jmp .end
.fs_analyze_disk:
    call fs_analyze_disk
    jmp .end
.fs_release_dir_root:
    call fs_release_dir_root
    jmp .end
.fs_get_continuing_section:
    call fs_get_continuing_section
    jmp .end
.fs_get_file_occupying:
    call fs_get_file_occupying
    jmp .end
.fs_read_file_pointer:
    call fs_read_file_pointer
    jmp .end
.fs_list_dir_root_files:
    call fs_list_dir_root_files
    jmp .end
.fs_find_file_entry_idx:
    call fs_find_file_entry_idx
    jmp .end
.fs_find_file_pointer:
    call fs_find_file_pointer
    jmp .end
.fs_find_file_size:
    call fs_find_file_size
    jmp .end
.alloc_setup:
    call alloc_setup
    jmp .end

; KERNEL FUNCTIONS

; ----------------------------------------------------------------------------------------
; JMPP: kernel_panic_handler
;   Displays a kernel panic message and waits for user input to either reboot or shutdown the system.
; PARAMS:
;   0x10 - error message string pointer
;
kernel_panic_handler:
    push32 0x10

    ldi32 0x10 KERNEL_PANIC_TEXT
    call puts               ; print full string

    pop32 0x10
    call puts               ; print full string
    push32 0x10

    ldi32 0x10 REBOOT_PROMPT_TEXT
    call puts               ; print full string

    call getc               ; wait for user input

    ldi8 0x11 'q'
    eq 0x10 0x11 0x11       ; test if character == 'q'
    jnz halt 0x11           ; if not 'q', reboot the system

    ldi8 0x11 'Q'
    eq 0x10 0x11 0x11       ; test if character == 'Q'
    jnz halt 0x11           ; if not 'Q', reboot the system

    pop32 0x10

    jmp reboot_routine

; ----------------------------------------------------------------------------------------
; JMPP: kernel_error_handler
;   Displays a kernel error message and waits for user input to continue executing code.
; PARAMS:
;   0x10 - error message string pointer
;
kernel_error_handler:
    push32 0x10

    ldi32 0x10 KERNEL_ERROR_TEXT
    call puts               ; print full string

    pop32 0x10
    call putu
    call puts               ; print full string
    push32 0x10

    ldi32 0x10 ANY_TO_CONTINUE_PROMPT_TEXT
    call puts               ; print full string

    call getc               ; wait for user input

    iret

; ----------------------------------------------------------------------------------------
; JMPP: reboot_routine
;   Resets all registers and jumps to 0x00000000 to reboot the system.
;
reboot_routine:
    ldi8 0x01 0x00
    ldi8 0x02 0x00
    ldi8 0x03 0x00
    ldi8 0x04 0x00
    ldi8 0x05 0x00
    ldi8 0x06 0x00
    ldi8 0x07 0x00
    ldi8 0x08 0x00
    ldi8 0x09 0x00
    ldi8 0x0A 0x00
    ldi8 0x0B 0x00
    ldi8 0x0C 0x00
    ldi8 0x0D 0x00
    ldi8 0x0E 0x00
    ldi8 0x0F 0x00
    ldi8 0x10 0x00
    ldi8 0x11 0x00
    ldi8 0x12 0x00
    ldi8 0x13 0x00
    ldi8 0x14 0x00
    ldi8 0x15 0x00
    ldi8 0x16 0x00
    ldi8 0x17 0x00
    ldi8 0x18 0x00
    ldi8 0x19 0x00
    ldi8 0x1A 0x00
    ldi8 0x1B 0x00
    ldi8 0x1C 0x00
    ldi8 0x1D 0x00
    ldi8 0x1E 0x00
    ldi8 0x1F 0x00
    ldi8 0x00 0x00 ; PC must be last

; ----------------------------------------------------------------------------------------
; SUBR: putc
;   Puts a character onto the screen through the TERMIO device.
; PARAMS:
;   0x10 - character byte
;
putc:
    push32 0x11

    ldi8 0x11 1             ; load port of TERMIO device into 0x11
    snd 0x11 0x10           ; send character in 0x10 to device 0x11

    pop32 0x11
    ret

; ----------------------------------------------------------------------------------------
; SUBR: puts
;   Puts a null-terminated string onto the screen through the TERMIO device.
; PARAMS:
;   0x10 - string pointer address
;
puts:
    push32 0x10
    push32 0x11
    push32 0x12
    push32 0x13
.loop:
    ldp8 0x11 0x10          ; load byte at [0x10] into 0x11
    ldi8 0x12 0x00

    eq 0x11 0x12 0x13       ; test if byte == 0x00
    jnz .end 0x13       ; exit loop if null terminator found

    push32 0x10
    mov 0x11 0x10           ; move character parameter to 0x10
    call putc
    pop32 0x10

    inc 0x10                ; point to next character
    jmp .loop
.end:
    pop32 0x13
    pop32 0x12
    pop32 0x11
    pop32 0x10
    ret

; ----------------------------------------------------------------------------------------
; SUBR: getc
;   Gets a character from the TERMIO device.
; RETURNS:
;   0x10 - character byte
;
getc:
    push32 0x11
.loop:
    ldi8 0x11 1             ; load port of TERMIO device into 0x11
    rcv 0x11 0x10           ; receive character from device 0

    ldi8 0x11 0x00          ; load none character into 0x11
    eq 0x10 0x11 0x11       ; test if character == none
    jnz .loop 0x11          ; if none, try again

    pop32 0x11

    ret

; ----------------------------------------------------------------------------------------
; SUBR: putu
;   Puts an unsigned 32-bit integer onto the screen through the TERMIO device.
; PARAMS:
;   0x10 - integer value
;
putu:
    push32 0x10
    push32 0x11
    push32 0x12
    push32 0x13             ; Digit counter

    ldi32 0x13 0            ; Initialize counter
.calc_loop:
    ldi8 0x11 10
    mod 0x10 0x11 0x12      ; 0x12 = 0x10 % 10
    ldi8 0x11 '0'
    add 0x12 0x11 0x12      ; Convert remainder to ASCII

    push32 0x12             ; Push digit ASCII onto stack
    inc 0x13                ; Increment digit count

    ldi8 0x11 10
    div 0x10 0x11 0x10      ; 0x10 = 0x10 / 10

    ldi8 0x11 0x00
    eq 0x10 0x11 0x11
    jz .calc_loop 0x11      ; Continue if quotient != 0
.print_loop:
    pop32 0x10              ; Pop ASCII character into 0x10 parameter
    call putc
    dec 0x13

    ldi8 0x11 0x00
    eq 0x13 0x11 0x11
    jz .print_loop 0x11     ; Loop until all digits printed
.end:
    pop32 0x13
    pop32 0x12
    pop32 0x11
    pop32 0x10

    ret

; ----------------------------------------------------------------------------------------
; SUBR: disk_read
;   Reads a byte from the DISKIO device
; PARAMS:
;   0x10 - num bytes
;   0x11 - store_location
;
disk_read:
    push32 0x10
    push32 0x11
    push32 0x08
.loop:
    jz .end 0x10

    ldi8 0x08 0x03          ; "DISKIO - Write / Read" port
    rcv 0x08 0x08

    stp8 0x08 0x11

    dec 0x10
    inc 0x11

    jmp .loop
.end:
    pop32 0x08
    pop32 0x11
    pop32 0x10
    ret

; ----------------------------------------------------------------------------------------
; SUBR: disk_write
;   Writes a byte to the DISKIO device
; PARAMS:
;   0x10 - byte
;
disk_write:
    push32 0x11
    ldi8 0x11 0x03 ; "DISKIO - Write / Read" port
    snd 0x11 0x10
    pop32 0x11
    ret

; ----------------------------------------------------------------------------------------
; SUBR: disk_seek
;   Seeks to a certain position in the disk
; PARAMS:
;   0x10 - byte
;
disk_seek:
    push32 0x11
    ldi8 0x11 0x02 ; "DISKIO - Seek" port
    snd 0x11 0x10
    pop32 0x11
    ret

; ----------------------------------------------------------------------------------------
; SUBR: set_process_ret
;   Sets the process return values
; PARAMS:
;   0x10 - return PC
;   0x11 - return MS
;
set_process_ret:
    st32 0x10 USER_PROCESS_RETURN_PC
    st32 0x11 USER_PROCESS_RETURN_MS

    push32 0x10
    ldi8 0x10 1
    st8 0x10 USER_PROCESS_RUNNING
    pop32 0x10

    ret

; ----------------------------------------------------------------------------------------
; SUBR: set_up_exit_code
;   Sets the user process exit code
; PARAMS:
;   0x10 - code
;
set_up_exit_code:
    st32 0x10 USER_PROCESS_EXIT_CODE
    ret

; ----------------------------------------------------------------------------------------
; SUBR: get_process_ret
;   Gets the user process exit code
; RETURNS:
;   0x10 - code
;
get_up_exit_code:
    ld32 0x10 USER_PROCESS_EXIT_CODE
    ret

; IVT

__ivt:

d32 generic_error_interrupt_handler             ; 0x00 - Generic Error Interrupt
d32 ram_inv_addr_error_handler                  ; 0x01 - RAM Invalid Address Error

d32 0 ; 0x02
d32 0 ; 0x03
d32 0 ; 0x04
d32 0 ; 0x05
d32 0 ; 0x06
d32 0 ; 0x07
d32 0 ; 0x08
d32 0 ; 0x09
d32 0 ; 0x0a
d32 0 ; 0x0b
d32 0 ; 0x0c
d32 0 ; 0x0d
d32 0 ; 0x0e
d32 0 ; 0x0f

d32 halt                ; 0x10
d32 syscall_int         ; 0x11

fill 952 ; rest

ins "os/kernel/common.yr2"
insc "os/kernel/common.yc"

insc "os/kernel/alloc_driver.yc"
insc "os/kernel/fs_driver.yc"

__end_of_kernel:
