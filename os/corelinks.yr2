; ========= KERNEL FUNCTIONS =========

halt:
    int 0x10

putc:
    push32 0x0f
    ldi8 0x0f 0
    int 0x11
    pop32 0x0f
    ret

puts:
    push32 0x0f
    ldi8 0x0f 1
    add 0x10 0x02 0x10
    int 0x11
    pop32 0x0f
    ret

putsr:
    push32 0x0f
    ldi8 0x0f 1
    int 0x11
    pop32 0x0f
    ret

putu:
    push32 0x0f
    ldi8 0x0f 2
    int 0x11
    pop32 0x0f
    ret

getc:
    push32 0x0f
    ldi8 0x0f 3

    push32 0x10
    int 0x11
    mov 0x10 0x1f

    pop32 0x10
    pop32 0x0f
    
    ret

disk_read:
    push32 0x0f
    ldi8 0x0f 4
    int 0x11
    pop32 0x0f
    ret

disk_write:
    push32 0x0f
    ldi8 0x0f 5
    int 0x11
    pop32 0x0f
    ret

disk_seek:
    push32 0x0f
    ldi8 0x0f 6
    int 0x11
    pop32 0x0f
    ret

set_process_ret:
    push32 0x0f
    ldi8 0x0f 7
    int 0x11
    pop32 0x0f
    ret

set_up_exit_code:
    push32 0x0f
    ldi8 0x0f 8
    int 0x11
    pop32 0x0f
    ret

get_up_exit_code:
    push32 0x0f
    ldi8 0x0f 9

    push32 0x10
    int 0x11
    mov 0x10 0x1f

    pop32 0x10
    pop32 0x0f
    
    ret

malloc:
    push32 0x0f
    ldi8 0x0f 10
    int 0x11
    pop32 0x0f
    sub 0x1f 0x02 0x1f
    ret

mfree:
    push32 0x0f
    ldi8 0x0f 11
    add 0x10 0x02 0x10
    int 0x11
    pop32 0x0f
    ret

fs_analyze_disk:
    push32 0x0f
    ldi8 0x0f 12
    int 0x11
    pop32 0x0f
    ret

fs_release_dir_root:
    push32 0x0f
    ldi8 0x0f 13
    int 0x11
    pop32 0x0f
    ret

fs_get_continuing_section:
    push32 0x0f
    ldi8 0x0f 14
    int 0x11
    pop32 0x0f
    ret

fs_get_file_occupying:
    push32 0x0f
    ldi8 0x0f 15
    int 0x11
    pop32 0x0f
    ret

fs_read_file_pointer:
    push32 0x0f
    add 0x11 0x02 0x11
    ldi8 0x0f 16
    int 0x11
    pop32 0x0f
    ret

fs_list_dir_root_files:
    push32 0x0f
    ldi8 0x0f 17
    int 0x11
    pop32 0x0f
    ret

fs_find_file_entry_idx:
    push32 0x0f
    ldi8 0x0f 18
    add 0x10 0x02 0x10
    int 0x11
    pop32 0x0f
    ret

fs_find_file_pointer:
    push32 0x0f
    ldi8 0x0f 19
    int 0x11
    pop32 0x0f
    ret

fs_find_file_size:
    push32 0x0f
    ldi8 0x0f 20
    int 0x11
    pop32 0x0f
    ret

alloc_setup:
    push32 0x0f
    ldi8 0x0f 21
    int 0x11
    pop32 0x0f
    ret

; ======= OTHER =======

__get_MS:
    mov 0x02 0x1f
    ret

__ljump:
    ljmp 0x10 0x11

__jump_to_user_code:
    push32 0x10
    push32 0x11
    push32 0x12
    push32 0x13
    push32 0x14
    push32 0x15
    push32 0x16
    push32 0x17
    push32 0x18
    push32 0x19
    push32 0x1a
    push32 0x1b
    push32 0x1c
    push32 0x1d
    push32 0x1e
    push32 0x1f

    ; Setup kernel process return

    push32 0x10
    ldi32 0x10 .process_return_pc
    mov 0x02 0x11
    call set_process_ret
    pop32 0x10

    add 0x10 0x02 0x10

    ldi8 0x11 0
    ljmp 0x10 0x11

.process_return_pc:
    pop32 0x1f
    pop32 0x1e
    pop32 0x1d
    pop32 0x1c
    pop32 0x1b
    pop32 0x1a
    pop32 0x19
    pop32 0x18
    pop32 0x17
    pop32 0x16
    pop32 0x15
    pop32 0x14
    pop32 0x13
    pop32 0x12
    pop32 0x11
    pop32 0x10

    ret

; Custom functions

puth:
    push32 0x10
    push32 0x11

    ldi8 0x11 10
    lt 0x10 0x11 0x11

    jnz .under_10 0x11

    ldi8 0x11 39
    add 0x10 0x11 0x10
.under_10:

    ldi8 0x11 '0'
    add 0x10 0x11 0x10

    call putc

    pop32 0x11
    pop32 0x10
    ret

; ----------------------------
; FUNCTION
; copy_mem
; 0x10 - ARG - address from
; 0x11 - ARG - address to
; 0x12 - ARG - num bytes
;
copy_mem:
    push32 0x10
    push32 0x11
    push32 0x12
    push32 0x13
.loop:
    ldp8 0x13 0x10
    stp8 0x13 0x11
    inc 0x10
    inc 0x11
    dec 0x12
    jnz .loop 0x12      ; if num bytes is not 0 continue
.end:
    pop32 0x13
    pop32 0x12
    pop32 0x11
    pop32 0x10
    ret

; ----------------------------------------------------------------------------------------
; SUBR: termf
;   Sets the flags of the TERMIO device.
; PARAMS:
;   0x10 - flags
;
termf:
    push32 0x11

    ldi8 0x11 4             ; load port of TERMIO STYLE device into 0x11
    snd 0x11 0x10           ; send character in 0x10 to device 0x11

    pop32 0x11
    ret

; ----------------------------------------------------------------------------------------
; SUBR: term_clear
;   Clears the screen using the TERMIO device.
;
term_clear:
    push32 0x10
    push32 0x11

    ldi8 0x10 '\n'
    ldi8 0x11 35
.loop:
    call putc
    dec 0x11
    jnz .loop 0x11
.end:
    pop32 0x11
    pop32 0x10
    ret
